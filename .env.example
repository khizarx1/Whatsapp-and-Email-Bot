# Server Port
PORT=3000

# Google Sheets Config
GOOGLE_SHEET_ID=enter-your-goolesheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Email Sender Config (Nodemailer - SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Email Receiver Config (IMAP Listener)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true

# WhatsApp Notification Destination (Group JID, Group Name, or Phone Number)
WHATSAPP_NOTIFICATION_CHAT=120363431529677429@g.us

# Optional: Phone number for pairing code login (if not scanning QR)
# WHATSAPP_PHONE_NUMBER=923140616029
